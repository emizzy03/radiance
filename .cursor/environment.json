{
  "name": "Radiance Backend",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "radiance-api",
      "command": "export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64; cd Back-End && java -jar target/radiance-1.1.jar",
      "description": "Radiance Spring Boot REST API on http://localhost:8080"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8080
    }
  ]
}
